    {
      "name": "clean",
      "source": "stdio:python",
      "tools": [
        {
          "name": "get_forecast",
          "description": "Returns a three-day weather forecast for a city.",
          "inputSchema": {
            "properties": {
              "city": {
                "maxLength": 80,
                "minLength": 1,
                "title": "City",
                "type": "string"
              }
            },
            "required": [
              "city"
            ],
            "type": "object",
            "title": "get_forecastArguments"
          },
          "annotations": {
            "readOnlyHint": true,
            "openWorldHint": false
          }
        },
        {
          "name": "convert_temperature",
          "description": "Converts a temperature between Celsius, Fahrenheit and Kelvin.",
          "inputSchema": {
            "properties": {
              "value": {
                "title": "Value",
                "type": "number"
              },
              "from_unit": {
                "enum": [
                  "c",
                  "f",
                  "k"
                ],
                "title": "From Unit",
                "type": "string"
              },
              "to_unit": {
                "enum": [
                  "c",
                  "f",
                  "k"
                ],
                "title": "To Unit",
                "type": "string"
              }
            },
            "required": [
              "value",
              "from_unit",
              "to_unit"
            ],
            "type": "object",
            "title": "convert_temperatureArguments"
          },
          "annotations": {
            "readOnlyHint": true
          }
        }
      ],
      "prompts": [
        {
          "name": "forecast_summary",
          "description": "Writes a short, friendly summary of a city's weather forecast.",
          "arguments": [
            {
              "name": "city",
              "required": true
            }
          ]
        }
      ],
