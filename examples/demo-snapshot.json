    {
      "name": "mail",
      "source": "stdio:python",
      "tools": [
        {
          "name": "send_email",
          "description": "Sends an email to one recipient in the company directory.",
          "inputSchema": {
            "properties": {
              "to": {
                "pattern": "^[A-Za-z0-9._%+-]+@example\\.com$",
